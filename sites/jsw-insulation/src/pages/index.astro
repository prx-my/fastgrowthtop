---
import { Font, Image, getImage } from "astro:assets";
import barnGable from "../assets/barn-gable.jpg";
import barnTrusses from "../assets/barn-trusses.jpg";
import barnWalls from "../assets/barn-walls.jpg";
import barnWide from "../assets/barn-wide.jpg";
import houseFraming from "../assets/house-framing.jpg";
import logoDark from "../assets/logo-dark.png";
import logoWhite from "../assets/logo-white.png";
import openBay from "../assets/open-bay.jpg";
import shopInterior from "../assets/shop-interior.jpg";
import spraying from "../assets/spraying.jpg";

// Facts follow the JSW concepts doc (16 Nov 2026): BBB profile + Michigan entity record.
// Held back until Joshua confirms: street address, service towns, years in business, hours, reviews, savings claims.
const name = "JSW Construction & Foam Insulation Inc.";
const phone = { display: "(231) 920-5777", tel: "+12319205777" };
const email = "jswfoam@gmail.com";
const facebook = "https://www.facebook.com/profile.php?id=61561305614764";
const googleProfile = "https://share.google/gdshpI8bFSMdiamRi";
const url = new URL(import.meta.env.BASE_URL, Astro.site).href;
const ogImage = new URL((await getImage({ src: barnWide, width: 1200, format: "jpg" })).src, Astro.site).href;
const title = "Spray Foam Insulation in LeRoy, MI | JSW Construction & Foam Insulation";
const description =
  "Spray foam and blown-in insulation, pole barns, garages, concrete flatwork and remodeling from JSW Construction and Foam Insulation in LeRoy, Michigan. Call (231) 920-5777.";

const nav = [
  { label: "Insulation", href: "#story" },
  { label: "Services", href: "#services" },
  { label: "Projects", href: "#projects" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#estimate" },
];

const chapters = [
  { scene: "wall", step: "Wall", title: "Foam that fills every gap.", body: "Cold air finds the gaps around studs and plates. Spray foam expands into the cavity, fills the corners and seals them. Less draft, more comfort, and a house that holds its heat." },
  { scene: "attic", step: "Attic", title: "Attics filled to depth.", body: "Spray foam is not the only tool. Blown-in cellulose fills the attic over the joists, with vents and baffles kept clear. It is the quiet work that shows up in warmer rooms upstairs." },
  { scene: "barn", step: "Pole barn", title: "A barn you can use in January.", body: "JSW builds too. Posts go in, trusses land, steel skins the walls and roof, then foam goes on the inside of the shell so the building works all winter, not just in July." },
  { scene: "slab", step: "Concrete", title: "Concrete finished the right way.", body: "Driveways, aprons and shop floors. Formed, poured, screeded and troweled with the same care as the foam and the frame." },
];

const stats = [
  { value: "A+", label: "BBB rating" },
  { value: "2", label: "Spray foam types, open and closed cell" },
  { value: "6", label: "Services under one roof" },
  { value: "1", label: "Crew from frame to foam" },
];

const services = [
  { img: barnWalls, title: "Spray foam insulation", body: "Open- and closed-cell foam for walls, rim joists and rooflines. Closed cell adds an air and moisture barrier on metal-sided barns." },
  { img: null, art: "attic", title: "Blown-in insulation", body: "Cellulose and loose fill for attics, from new builds to older homes that need topping up." },
  { img: barnGable, title: "Pole barns", body: "Posts, trusses and steel, built to work, with foam on the inside of the shell when you want to use it year round." },
  { img: openBay, title: "Garage buildings", body: "Garages and shop buildings framed and insulated by the same crew." },
  { img: null, art: "slab", title: "Concrete flatwork", body: "Driveways, aprons and shop floors, poured, struck and troweled." },
  { img: houseFraming, title: "Remodeling", body: "Rooms that feel finished, with the insulation done right while the walls are open." },
];

const projects = [
  { img: spraying, tag: "Closed cell", color: "#E8DCC8", title: "Spraying pole barn walls", body: "Crew on the lift foaming a pole building." },
  { img: barnWide, tag: "Pole barn", color: "#C9D6DF", title: "Large pole building", body: "Every wall foamed, ready for the ceiling." },
  { img: barnWalls, tag: "Closed cell", color: "#E8DCC8", title: "Pole barn walls", body: "Air and moisture barrier on metal siding." },
  { img: barnGable, tag: "Shop", color: "#C8D5C3", title: "Gable end and walls", body: "Full coverage up into the gable." },
  { img: openBay, tag: "Garage", color: "#D9CBBF", title: "Open-bay garage", body: "Foamed walls, ready for overhead doors." },
  { img: houseFraming, tag: "Residential", color: "#E6C9C2", title: "Interior framing", body: "Foam on the exterior wall of a new build." },
  { img: shopInterior, tag: "Shop", color: "#C8D5C3", title: "Shop interior", body: "Insulated walls under open trusses." },
  { img: barnTrusses, tag: "Pole barn", color: "#C9D6DF", title: "Under the trusses", body: "Wide-span building, walls complete." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name,
  url,
  logo: new URL(logoDark.src, Astro.site).href,
  image: ogImage,
  telephone: "+1-231-920-5777",
  email,
  description,
  address: { "@type": "PostalAddress", addressLocality: "LeRoy", addressRegion: "MI", postalCode: "49655", addressCountry: "US" },
  sameAs: [facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#1C1916" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={logoDark.src} />
    <link rel="llms-txt" href={`${import.meta.env.BASE_URL}/llms.txt`} />
    <Font cssVariable="--font-open-sans" preload />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="nav-bar">
        <a class="nav-logo" href="#main" aria-label={`${name} home`}>
          <Image src={logoWhite} alt="" width={90} densities={[1, 2]} loading="eager" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><span></span><span></span><span></span></button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
        <div class="nav-actions">
          <a class="nav-call" href={`tel:${phone.tel}`}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>{phone.display}</a>
          <a class="btn btn-red btn-sm" href="#estimate">Get a free estimate</a>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- 1. Hero: a Michigan winter -->
      <section class="hero" aria-labelledby="hero-title">
        <Image class="hero-bg" src={barnWide} alt="" widths={[480, 768, 1080, 1600]} sizes="100vw" quality={45} priority />
        <div class="snow" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <span class="logo-badge">
              <Image src={logoDark} alt="JSW Foam Insulation Inc." width={150} densities={[1, 2]} loading="eager" />
            </span>
            <h1 id="hero-title">Built for <span>Michigan winters.</span></h1>
            <p class="hero-sub">JSW Construction and Foam Insulation. Spray foam, blown-in insulation, pole barns, garages, concrete, and remodeling.</p>
            <a class="hero-scroll" href="#story">See what goes inside the walls <span aria-hidden="true">↓</span></a>
          </div>

          <form class="estimate-card" id="estimate" aria-labelledby="estimate-title">
            <h2 id="estimate-title" class="estimate-title">Ask for a <span class="pill">free estimate</span></h2>
            <div class="grid-2">
              <label class="sr-only" for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" placeholder="Name *" required />
              <label class="sr-only" for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="Phone *" required />
              <label class="sr-only" for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" placeholder="Email" />
              <label class="sr-only" for="f-town">Town</label><input id="f-town" name="town" autocomplete="address-level2" placeholder="Town *" required />
            </div>
            <label class="sr-only" for="f-type">Project type</label>
            <select id="f-type" name="type" required>
              <option value="">Project type</option>
              <option>Insulation</option>
              <option>Pole barn or garage</option>
              <option>Concrete</option>
              <option>Remodeling</option>
            </select>
            <label class="sr-only" for="f-msg">Short description</label>
            <textarea id="f-msg" name="message" rows="3" placeholder="Tell us about the job"></textarea>
            <button class="btn btn-red btn-block" type="button">Send my request</button>
            <p class="form-note">Mockup: this form does not send. Or call <a href={`tel:${phone.tel}`}>{phone.display}</a>.</p>
          </form>
        </div>
      </section>

      <!-- 2-5. The scroll story: one winter property, wall to slab -->
      <section class="story" id="story" aria-labelledby="story-title">
        <div class="container story-intro">
          <h2 id="story-title">What is inside the walls matters.</h2>
          <p>Foam is not a mystery product. It seals the gaps that make a Michigan house hard to heat. Scroll through one job, from the wall to the slab.</p>
        </div>
        <div class="story-pin">
          <ol class="story-steps container" aria-hidden="true">
            {chapters.map((c, i) => <li class={i === 0 ? "active" : ""}><span>{String(i + 1).padStart(2, "0")}</span>{c.step}</li>)}
          </ol>
          <div class="chapters container">
            {chapters.map((c, i) => (
              <article class="chapter" data-scene={c.scene} aria-labelledby={`ch-${c.scene}`}>
                <div class="ch-text">
                  <p class="ch-num">{String(i + 1).padStart(2, "0")} / {c.step}</p>
                  <h3 id={`ch-${c.scene}`}>{c.title}</h3>
                  <p>{c.body}</p>
                  <div class="ch-cta">
                    <a class="btn btn-red" href="#estimate">Get a free estimate</a>
                    <a class="accent-link" href={`tel:${phone.tel}`}>{phone.display}</a>
                  </div>
                </div>
                <div class="ch-art">
                  {c.scene === "wall" && (
                    <svg viewBox="0 0 600 440" aria-hidden="true">
                      <defs><pattern id="snow-a" width="60" height="60" patternUnits="userSpaceOnUse"><circle cx="10" cy="12" r="2.2" fill="#fff" /><circle cx="42" cy="30" r="1.6" fill="#fff" /><circle cx="24" cy="50" r="1.3" fill="#fff" /></pattern></defs>
                      <rect width="600" height="440" fill="#EDE6DA" />
                      <rect class="warm" x="350" width="250" height="440" fill="#F2C892" opacity=".55" />
                      <rect width="216" height="440" fill="#D5DEE6" /><rect width="216" height="440" fill="url(#snow-a)" />
                      <rect x="200" y="24" width="16" height="392" fill="#5C6570" /><path d="M208 24v392" stroke="#7A838D" stroke-width="2" />
                      <rect x="216" y="24" width="10" height="392" fill="#B08D63" />
                      <rect x="226" y="42" width="114" height="356" fill="#3B342D" />
                      <g class="foam">
                        <path d="M226 398V56q9.5-12 19-4t19 0t19 0t19 0t19 0t19-2V398Z" fill="#E8DCC8" />
                        <g fill="#D7C8AE"><circle cx="250" cy="120" r="5" /><circle cx="300" cy="170" r="4" /><circle cx="270" cy="240" r="6" /><circle cx="318" cy="300" r="4" /><circle cx="246" cy="340" r="4" /><circle cx="296" cy="88" r="3" /></g>
                      </g>
                      <rect x="226" y="24" width="114" height="18" fill="#6B4F3A" /><rect x="226" y="398" width="114" height="18" fill="#6B4F3A" />
                      <rect x="340" y="24" width="12" height="392" fill="#F4F1EA" stroke="#CFC6B6" />
                      <g class="drafts" fill="#8FA6B8">
                        {[46, 120, 190, 260, 330, 392, 80, 300].map((y, k) => <circle cx="12" cy={y} r="4" style={`--i:${k}`} />)}
                      </g>
                      <g transform="translate(470 110)">
                        <rect width="24" height="200" rx="12" fill="#fff" stroke="#1C1916" stroke-width="3" />
                        <rect class="mercury" x="7" y="24" width="10" height="170" rx="5" fill="#B5452E" />
                        <circle class="bulb" cx="12" cy="208" r="19" fill="#B5452E" stroke="#1C1916" stroke-width="3" />
                      </g>
                      <text class="lbl" x="24" y="56">Outside</text><text class="lbl" x="374" y="56">Inside</text>
                      <text class="foam-label lbl" x="283" y="230" text-anchor="middle" transform="rotate(-90 283 230)">Spray foam</text>
                    </svg>
                  )}
                  {c.scene === "attic" && (
                    <svg viewBox="0 0 600 440" aria-hidden="true">
                      <defs>
                        <pattern id="snow-b" width="60" height="60" patternUnits="userSpaceOnUse"><circle cx="10" cy="12" r="2.2" fill="#fff" /><circle cx="42" cy="30" r="1.6" fill="#fff" /><circle cx="24" cy="50" r="1.3" fill="#fff" /></pattern>
                        <pattern id="fleck" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="3" cy="4" r="1.4" fill="#B49F7E" /><circle cx="10" cy="10" r="1.1" fill="#E1D4BC" /></pattern>
                        <clipPath id="attic-clip"><polygon points="62,300 300,92 538,300" /></clipPath>
                      </defs>
                      <rect width="600" height="440" fill="#D5DEE6" /><rect width="600" height="300" fill="url(#snow-b)" />
                      <rect x="62" y="300" width="476" height="140" fill="#EDE6DA" />
                      <rect class="warm" x="62" y="300" width="476" height="140" fill="#F2C892" opacity=".5" />
                      <polygon points="62,300 300,92 538,300" fill="#3B342D" />
                      <g fill="#6B4F3A">{[84, 132, 180, 228, 276, 324, 372, 420, 468, 504].map((x) => <rect x={x} y="282" width="12" height="18" />)}</g>
                      <g clip-path="url(#attic-clip)"><g class="fill"><rect x="62" y="236" width="476" height="64" fill="#CDBB9C" /><rect x="62" y="236" width="476" height="64" fill="url(#fleck)" /></g></g>
                      <path d="M92 284l38-34M508 284l-38-34" stroke="#E8DCC8" stroke-width="8" stroke-linecap="round" />
                      <g class="flakes" fill="#E1D4BC">{[[250, 120], [290, 140], [330, 118], [270, 160], [310, 172], [350, 150], [230, 150]].map(([x, y], k) => <rect x={x} y={y} width="6" height="6" style={`--i:${k}`} />)}</g>
                      <g class="depth"><path d="M84 236H516" stroke="#E8DCC8" stroke-width="3" stroke-dasharray="10 8" /><text class="lbl light" x="300" y="226" text-anchor="middle">Filled to depth</text></g>
                      <rect x="62" y="300" width="476" height="8" fill="#F4F1EA" />
                      <polyline points="34,318 300,74 566,318" fill="none" stroke="#5C6570" stroke-width="16" stroke-linejoin="round" />
                      <text class="lbl" x="300" y="384" text-anchor="middle">Upstairs room</text>
                    </svg>
                  )}
                  {c.scene === "barn" && (
                    <svg viewBox="0 0 600 440" aria-hidden="true">
                      <defs><pattern id="snow-c" width="60" height="60" patternUnits="userSpaceOnUse"><circle cx="10" cy="12" r="2.2" fill="#fff" /><circle cx="42" cy="30" r="1.6" fill="#fff" /><circle cx="24" cy="50" r="1.3" fill="#fff" /></pattern></defs>
                      <rect width="600" height="440" fill="#D5DEE6" /><rect width="600" height="380" fill="url(#snow-c)" />
                      <path d="M40 380l26-80 26 80zM508 380l26-90 26 90z" fill="#2F3D2C" />
                      <rect y="380" width="600" height="60" fill="#F4F1EA" />
                      <polygon class="warm" points="150,380 150,234 300,146 450,234 450,380" fill="#F2C892" opacity=".5" />
                      <rect x="262" y="300" width="76" height="80" fill="#2F3D2C" opacity=".8" />
                      <rect class="post" x="150" y="226" width="16" height="156" fill="#6B4F3A" />
                      <rect class="post" x="434" y="226" width="16" height="156" fill="#6B4F3A" />
                      <g class="truss" fill="none" stroke="#6B4F3A" stroke-linejoin="round"><path d="M150 234L300 146L450 234Z" stroke-width="8" /><path d="M300 146V234M222 234L300 190L378 234" stroke-width="5" /></g>
                      <path class="steel" d="M126 386V222L300 116L474 222V386" fill="none" stroke="#5C6570" stroke-width="10" stroke-linejoin="round" />
                      <path class="foam-line" d="M140 380V228L300 133L460 228V380" fill="none" stroke="#A88F68" stroke-width="17" stroke-linejoin="round" />
                      <path class="foam-line" d="M140 380V228L300 133L460 228V380" fill="none" stroke="#F4ECDD" stroke-width="12" stroke-linejoin="round" />
                      <g class="barn-label"><text class="lbl" x="482" y="300">Steel</text><text class="lbl" x="300" y="420" text-anchor="middle">Foam on the inside of the shell</text></g>
                    </svg>
                  )}
                  {c.scene === "slab" && (
                    <svg viewBox="0 0 600 440" aria-hidden="true">
                      <rect width="600" height="210" fill="#D5DEE6" /><rect y="210" width="600" height="230" fill="#CBBFAC" />
                      <polygon points="134,96 300,30 466,96" fill="#5C6570" />
                      <rect x="150" y="92" width="300" height="130" fill="#EDE6DA" />
                      <rect x="214" y="138" width="172" height="84" fill="#9AA1A8" /><path d="M214 159h172M214 180h172M214 201h172" stroke="#868D95" stroke-width="2" />
                      <clipPath id="pour-clip"><rect class="pour-mask" x="0" y="222" width="600" height="182" /></clipPath>
                      <polygon class="pour" clip-path="url(#pour-clip)" points="150,222 450,222 560,402 40,402" fill="#C9CCCF" />
                      <g class="marks" fill="none" stroke="#fff" stroke-opacity=".45" stroke-width="3"><path d="M160 330q80-30 160 0M300 290q70-24 140 0M120 370q90-28 180 0" /></g>
                      <polygon class="forms" points="150,222 450,222 560,402 40,402" fill="none" stroke="#6B4F3A" stroke-width="8" stroke-linejoin="round" />
                      <rect class="screed" x="70" y="226" width="460" height="8" rx="3" fill="#B08D63" opacity="0" />
                      <g class="trowel" transform="translate(280 320)" opacity="0"><path d="M0 0h52l-12 12H0z" fill="#5C6570" /><rect x="20" y="-18" width="6" height="18" fill="#6B4F3A" /></g>
                      <text class="slab-label lbl" x="300" y="430" text-anchor="middle">Formed, poured, screeded, troweled</text>
                    </svg>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. The ask -->
      <section class="ask" aria-labelledby="ask-title">
        <div class="container">
          <h2 id="ask-title">You have seen the work.</h2>
          <p>Ask for a free estimate, or call Joshua at <a href={`tel:${phone.tel}`}>{phone.display}</a>.</p>
          <div class="btns"><a class="btn btn-red" href="#estimate">Get a free estimate</a><a class="btn btn-ghost" href={`tel:${phone.tel}`}>Call {phone.display}</a></div>
        </div>
      </section>

      <!-- Services -->
      <section class="services" id="services" aria-labelledby="services-title">
        <div class="container">
          <h2 id="services-title">Insulation, barns, concrete and remodeling</h2>
          <p class="section-sub">Residential and commercial work, built for Michigan winters</p>
          <ul class="service-grid">
            {services.map((s) => (
              <li class="service-card">
                {s.img ? (
                  <Image src={s.img} alt="" widths={[400, 640]} sizes="(min-width: 992px) 33vw, (min-width: 640px) 50vw, 100vw" />
                ) : s.art === "attic" ? (
                  <div class="service-art" aria-hidden="true"><svg viewBox="0 0 120 80"><path d="M10 44 60 8l50 36" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /><g fill="currentColor" opacity=".55"><circle cx="34" cy="34" r="3" /><circle cx="46" cy="28" r="2.5" /><circle cx="58" cy="32" r="3.5" /><circle cx="70" cy="27" r="2.5" /><circle cx="82" cy="34" r="3" /></g><path d="M22 40h76" stroke="currentColor" stroke-width="3" /><path d="M22 44v28h76V44" fill="none" stroke="currentColor" stroke-width="4" /></svg></div>
                ) : (
                  <div class="service-art" aria-hidden="true"><svg viewBox="0 0 120 80"><path d="M30 28h60l22 40H8z" fill="currentColor" opacity=".35" /><path d="M30 28h60l22 40H8z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /><path d="M40 52q20-8 40 0" fill="none" stroke="currentColor" stroke-width="2.5" /></svg></div>
                )}
                <div class="service-body">
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Projects -->
      <section class="projects" id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Our latest projects</h2>
        <p class="section-sub dark">Real jobs from our crew, straight from our Facebook page</p>
        <div class="carousel">
          <button class="carousel-arrow prev" type="button" aria-label="Previous projects" data-dir="-1">‹</button>
          <ul class="carousel-track" tabindex="0" aria-label="Project photos, scroll sideways for more">
            {projects.map((p) => (
              <li class="project-card">
                <Image src={p.img} alt={`${p.title}. ${p.body}`} widths={[320, 640]} sizes="(min-width: 768px) 300px, 78vw" />
                <div class="card-content">
                  <span class="tag" style={`background:${p.color}`}>{p.tag}</span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </li>
            ))}
          </ul>
          <button class="carousel-arrow next" type="button" aria-label="Next projects" data-dir="1">›</button>
        </div>
      </section>

      <!-- About -->
      <section class="about" id="about" aria-labelledby="about-title">
        <div class="about-img">
          <Image src={spraying} alt="JSW crew on a lift spraying closed-cell foam on pole building walls" widths={[480, 768, 1024]} sizes="(min-width: 900px) 42vw, 100vw" />
        </div>
        <div class="about-copy">
          <h2 id="about-title" class="section-title">Straight talk, <span class="pill">solid work.</span></h2>
          <p>JSW Construction and Foam Insulation is a Michigan contractor run by <strong>Joshua R. Wheeler</strong>. We insulate with open- and closed-cell spray foam and blown-in cellulose, and we build pole barns, garages, concrete flatwork and remodels.</p>
