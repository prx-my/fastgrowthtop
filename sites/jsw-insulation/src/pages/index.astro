      .project-card { position: relative; flex: 0 0 78%; max-width: 300px; aspect-ratio: 300 / 380; border-radius: 14px; overflow: hidden; scroll-snap-align: start; box-shadow: 0 10px 24px rgba(0, 0, 0, .18); background: var(--ink-2); }
      .project-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
      .project-card:hover img { transform: scale(1.06); }
      .card-content { position: absolute; left: 0; right: 0; bottom: 0; padding: 48px 20px 20px; background: linear-gradient(transparent, rgba(0, 0, 0, .9)); color: var(--white); text-align: left; }
      .tag { display: inline-block; padding: 3px 12px; border-radius: 999px; color: var(--ink); font-size: .72rem; font-weight: 700; margin-bottom: 8px; }
      .card-content h3 { font-size: 1.15rem; font-weight: 700; line-height: 1.3; }
      .card-content p { font-size: .85rem; line-height: 1.5; color: #e7e2da; margin-top: 4px; }
      .carousel-arrow { display: none; }

      /* about */
      .about { display: grid; background: var(--white); }
      .about-img img { width: 100%; height: 100%; min-height: 280px; max-height: 440px; object-fit: cover; }
      .about-copy { padding: 48px 20px; max-width: 760px; }
      .about-copy p { margin-bottom: 14px; color: #3a3631; }
      .section-title { font-size: clamp(1.6rem, 3.6vw, 2.2rem); font-weight: 800; line-height: 1.3; color: var(--ink); margin-bottom: 24px; }
      .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36px 16px; margin: 40px 0 36px; text-align: center; }
      .stats li { display: flex; flex-direction: column; align-items: center; max-width: 170px; margin: 0 auto; width: 100%; }
      .stat-value { position: relative; z-index: 1; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: radial-gradient(circle at top, #a83b27, var(--red-dark)); color: var(--white); font-size: 1.6rem; font-weight: 800; border: 4px solid var(--white); box-shadow: 0 6px 14px rgba(0, 0, 0, .2); }
      .stat-label { width: 100%; height: 100%; margin-top: -42px; padding: 50px 10px 16px; border-radius: 10px; background: linear-gradient(to bottom, var(--ink-2), var(--ink-3)); color: var(--white); font-size: .8rem; font-weight: 700; line-height: 1.35; }
      .about-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; font-size: 1.1rem; }

      /* credentials */
      .trust-band { background: var(--pine); color: var(--white); padding: 28px 0; }
