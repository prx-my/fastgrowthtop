      .service-body { padding: 22px; }
      .service-body h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; }
      .service-body p { color: rgba(255, 255, 255, .8); font-size: .95rem; line-height: 1.6; }

      /* projects */
      .projects { background: var(--snow); padding: 72px 0; text-align: center; }
