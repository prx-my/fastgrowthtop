---
import { Font, Image, getImage } from "astro:assets";
import barnGable from "../assets/barn-gable.jpg";
import barnTrusses from "../assets/barn-trusses.jpg";
import barnWalls from "../assets/barn-walls.jpg";
import barnWide from "../assets/barn-wide.jpg";
import houseFraming from "../assets/house-framing.jpg";
import logoDark from "../assets/logo-dark.png";
import logoWhite from "../assets/logo-white.png";
import openBay from "../assets/open-bay.jpg";
import shopInterior from "../assets/shop-interior.jpg";
import spraying from "../assets/spraying.jpg";

// Business details from JSW's Google profile, Facebook page and BBB listing (Nov 2026).
// Unknown and left out on purpose: street address, business hours, reviews, "free" estimates.
const name = "JSW Construction & Foam Insulation Inc.";
const phone = { display: "(231) 920-5777", tel: "+12319205777" };
const email = "jswfoam@gmail.com";
const facebook = "https://www.facebook.com/profile.php?id=61561305614764";
const googleProfile = "https://share.google/gdshpI8bFSMdiamRi";
const url = new URL(import.meta.env.BASE_URL, Astro.site).href;
const ogImage = new URL((await getImage({ src: barnWide, width: 1200, format: "jpg" })).src, Astro.site).href;
const title = "Spray Foam Insulation & Pole Barns in LeRoy, MI | JSW Foam Insulation";
const description =
  "Open- and closed-cell spray foam, cellulose attic insulation and pole building construction in LeRoy, Reed City, Evart and Osceola County, MI. Call (231) 920-5777.";
const towns = ["LeRoy", "Reed City", "Evart", "Marion", "Tustin", "Hersey", "Sears"];

const nav = [
  { label: "Services", href: "#services" },
  { label: "About Us", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Service Area", href: "#area" },
  { label: "Contact Us", href: "#estimate" },
];

const stats = [
  { value: "9+", label: "Years In Business" },
  { value: "A+", label: "BBB Rating" },
  { value: "70", label: "Mile Service Radius" },
  { value: "3", label: "Insulation Types We Install" },
];

const services = [
  { img: barnWalls, title: "Closed-Cell Spray Foam", body: "Dense foam that adds an air and moisture barrier and stiffens the wall. The go-to for metal-sided pole barns and shops." },
  { img: houseFraming, title: "Open-Cell Spray Foam", body: "Lighter and lower cost per inch. Fills walls and rooflines in homes and additions and helps quiet sound." },
  { img: barnGable, title: "Pole Barn & Shop Insulation", body: "Walls, gable ends and ceilings foamed so your barn, shop or garage holds heat in winter and stays dry." },
  { img: null, title: "Cellulose Attic Insulation", body: "Blown-in cellulose and loose-fill for attics, from new builds to older homes that need topping up." },
  { img: barnTrusses, title: "Pole Building Construction", body: "We build pole buildings and garage buildings too, so one crew handles the frame and the insulation." },
  { img: openBay, title: "Concrete, Additions & Remodeling", body: "Concrete flat work, additions and remodeling, with general contracting available for the whole job." },
];

const projects = [
  { img: spraying, tag: "Closed-Cell", color: "#FDBA74", title: "Spraying Pole Barn Walls", body: "Crew on the lift foaming a pole building." },
  { img: barnWide, tag: "Pole Barn", color: "#7DD3FC", title: "Large Pole Building", body: "Every wall foamed, ready for the ceiling." },
  { img: barnWalls, tag: "Closed-Cell", color: "#FDBA74", title: "Pole Barn Walls", body: "Air and moisture barrier on metal siding." },
  { img: barnGable, tag: "Shop", color: "#86EFAC", title: "Gable End & Walls", body: "Full coverage up into the gable." },
  { img: openBay, tag: "Garage", color: "#C4B5FD", title: "Open-Bay Garage", body: "Foamed walls, ready for overhead doors." },
  { img: houseFraming, tag: "Residential", color: "#F9A8D4", title: "Interior Framing", body: "Foam on the exterior wall of a new build." },
  { img: shopInterior, tag: "Shop", color: "#86EFAC", title: "Shop Interior", body: "Insulated walls under open trusses." },
  { img: barnTrusses, tag: "Pole Barn", color: "#7DD3FC", title: "Under the Trusses", body: "Wide-span building, walls complete." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name,
  url,
  logo: new URL(logoDark.src, Astro.site).href,
  image: ogImage,
  telephone: "+1-231-920-5777",
  email,
  foundingDate: "2017",
  description,
  address: { "@type": "PostalAddress", addressLocality: "LeRoy", addressRegion: "MI", postalCode: "49655", addressCountry: "US" },
  areaServed: towns.map((t) => ({ "@type": "City", name: `${t}, MI` })),
  sameAs: [facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#16191D" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={logoDark.src} />
    <link rel="llms-txt" href={`${import.meta.env.BASE_URL}/llms.txt`} />
    <Font cssVariable="--font-open-sans" preload />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="nav-bar">
        <a class="nav-call" href={`tel:${phone.tel}`}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>{phone.display}</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><span></span><span></span><span></span></button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero" aria-labelledby="hero-title">
        <Image class="hero-bg" src={barnWide} alt="" widths={[480, 768, 1080, 1600]} sizes="100vw" quality={45} priority />
        <div class="container hero-grid">
          <div class="hero-copy">
            <a class="logo-badge" href="#main" aria-label={`${name} home`}>
              <Image src={logoDark} alt="JSW Foam Insulation Inc." width={150} densities={[1, 2]} loading="eager" />
            </a>
            <h1 id="hero-title">Northern Michigan <span>Spray Foam</span> Insulation</h1>
            <p class="hero-sub">Open- and closed-cell spray foam, cellulose attic insulation and pole building construction. Licensed and insured, based in LeRoy and serving Osceola County since 2017.</p>
          </div>

          <form class="estimate-card" id="estimate" aria-labelledby="estimate-title">
            <h2 id="estimate-title" class="estimate-title">Get Your <span class="pill">Estimate Now</span></h2>
            <div class="grid-2">
              <label class="sr-only" for="f-first">First name</label><input id="f-first" name="first" autocomplete="given-name" placeholder="First Name *" required />
              <label class="sr-only" for="f-last">Last name</label><input id="f-last" name="last" autocomplete="family-name" placeholder="Last Name *" required />
              <label class="sr-only" for="f-phone">Phone number</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="Phone *" required />
              <label class="sr-only" for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" placeholder="Email" />
            </div>
            <label class="sr-only" for="f-zip">ZIP code</label><input id="f-zip" name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="5" placeholder="Zip Code *" required />
            <label class="sr-only" for="f-service">Service needed</label>
            <select id="f-service" name="service">
              <option value="">What do you need insulated or built?</option>
              <option>Spray foam: pole barn or shop</option>
              <option>Spray foam: home or addition</option>
              <option>Cellulose attic insulation</option>
              <option>Pole building construction</option>
              <option>Concrete, addition or remodel</option>
              <option>Other</option>
            </select>
            <label class="sr-only" for="f-msg">Tell us about the building</label>
            <textarea id="f-msg" name="message" rows="3" placeholder="Building size, location, timeline..."></textarea>
            <button class="btn btn-accent btn-block" type="button">Request My Estimate</button>
            <p class="form-note">Mockup: this form does not send. Prefer to talk? Call or text <a href={`tel:${phone.tel}`}>{phone.display}</a>.</p>
          </form>
        </div>
      </section>

      <!-- About -->
      <section class="about" id="about" aria-labelledby="about-title">
        <div class="about-img">
          <Image src={spraying} alt="JSW crew on a lift spraying closed-cell foam on pole building walls" widths={[480, 768, 1024]} sizes="(min-width: 992px) 42vw, 100vw" />
        </div>
        <div class="about-copy">
          <h2 id="about-title" class="section-title">LeRoy's Insulation Crew With A Track Record <span class="pill">You Can TRUST.</span></h2>
          <p>Insulation is the part of a building you never see again once the walls close up. If it's done wrong, you find out in your heating bill, or when condensation starts dripping off the steel.</p>
          <p>JSW Construction &amp; Foam Insulation is a <strong>licensed and insured</strong> crew based right here in LeRoy. We spray open- and closed-cell foam, blow in cellulose, and build pole buildings ourselves, so we know how a building goes together, not just how to insulate it.</p>
          <p>We work for homeowners, farms and businesses across Osceola County and about 70 miles around. Here's what backs that up:</p>
          <ul class="stats">
            {stats.map((s) => (
              <li><span class="stat-value">{s.value}</span><span class="stat-label">{s.label}</span></li>
            ))}
          </ul>
          <div class="about-cta">
            <a class="btn btn-outline" href="#estimate">Get An Estimate <span aria-hidden="true">❯</span></a>
            <span>or Call <a class="accent-link" href={`tel:${phone.tel}`}>{phone.display}</a></span>
          </div>
        </div>
      </section>

      <!-- Services -->
      <section class="services" id="services" aria-labelledby="services-title">
        <div class="container">
          <h2 id="services-title">Our Insulation &amp; Building Services</h2>
          <p class="section-sub">Residential and commercial work across Osceola County and Northern Michigan</p>
          <ul class="service-grid">
            {services.map((s) => (
              <li class="service-card">
                {s.img ? (
                  <Image src={s.img} alt="" widths={[400, 640]} sizes="(min-width: 992px) 33vw, (min-width: 640px) 50vw, 100vw" />
                ) : (
                  <div class="service-art" aria-hidden="true">
                    <svg viewBox="0 0 120 80"><path d="M10 44 60 8l50 36" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M22 36h76" stroke="currentColor" stroke-width="2" opacity=".5"/><g fill="currentColor" opacity=".55"><circle cx="34" cy="30" r="3"/><circle cx="46" cy="24" r="2.5"/><circle cx="58" cy="28" r="3.5"/><circle cx="70" cy="23" r="2.5"/><circle cx="82" cy="30" r="3"/><circle cx="52" cy="33" r="2"/><circle cx="66" cy="32" r="2.5"/></g><path d="M22 44v28h76V44" fill="none" stroke="currentColor" stroke-width="4"/></svg>
                  </div>
                )}
                <div class="service-body">
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Projects -->
      <section class="projects" id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Our Latest Projects</h2>
        <p class="section-sub dark">Real jobs from our crew, straight from our Facebook page</p>
        <div class="carousel">
          <button class="carousel-arrow prev" type="button" aria-label="Previous projects" data-dir="-1">‹</button>
          <ul class="carousel-track" tabindex="0" aria-label="Project photos, scroll sideways for more">
            {projects.map((p) => (
              <li class="project-card">
                <Image src={p.img} alt={`${p.title}: ${p.body}`} widths={[320, 640]} sizes="(min-width: 768px) 300px, 78vw" />
                <div class="card-content">
                  <span class="tag" style={`background:${p.color}`}>{p.tag}</span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </li>
            ))}
          </ul>
          <button class="carousel-arrow next" type="button" aria-label="Next projects" data-dir="1">›</button>
        </div>
      </section>

      <!-- Credentials -->
      <section class="trust-band" aria-label="Credentials">
        <ul class="container">
          <li><strong>Licensed</strong> &amp; Insured</li>
          <li><strong>A+</strong> BBB Rating</li>
          <li><strong>Residential</strong> &amp; Commercial</li>
          <li><strong>Since 2017</strong> in Northern Michigan</li>
        </ul>
      </section>

      <!-- Service area -->
      <section class="area" id="area" aria-labelledby="area-title">
        <div class="container area-grid">
          <div>
            <h2 id="area-title" class="section-title">Areas We Serve</h2>
            <p>Based in LeRoy, we insulate and build within about 70 miles, across Osceola County and Northern Michigan.</p>
            <ul class="towns">{towns.map((t) => <li>{t}, MI</li>)}</ul>
            <p class="small">Don't see your town? Call or text <a class="accent-link" href={`tel:${phone.tel}`}>{phone.display}</a> and we'll tell you if we can reach you.</p>
          </div>
          <div class="map-facade" data-src="https://maps.google.com/maps?q=LeRoy,+MI+49655&z=9&output=embed">
            <button class="btn btn-accent" type="button">Show Map</button>
            <a href="https://www.google.com/maps/search/?api=1&query=LeRoy%2C+MI+49655">Open LeRoy, MI in Google Maps</a>
          </div>
        </div>
      </section>

      <!-- Leave a review -->
      <section class="review-cta" aria-labelledby="review-title">
        <div class="container">
          <p class="review-kicker">Worked with us? Please leave a review on</p>
          <h2 id="review-title"><span class="g">Google</span> | <span class="f">Facebook</span></h2>
          <div class="review-badges">
            <a class="review-badge google" href={googleProfile} rel="noopener">
              <span>Review us on</span>
              <svg aria-hidden="true" viewBox="0 0 48 48"><path fill="#4285F4" d="M45 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8a10 10 0 0 1-4.4 6.6v5.5h7.1C42.6 36.8 45 31.2 45 24.5z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.4l-7.1-5.5a13.2 13.2 0 0 1-19.7-6.9H4.4v5.7A22 22 0 0 0 24 46z"/><path fill="#FBBC05" d="M11.7 28.2a13.2 13.2 0 0 1 0-8.4v-5.7H4.4a22 22 0 0 0 0 19.8z"/><path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3A22 22 0 0 0 4.4 14.1l7.3 5.7c1.7-5.2 6.6-9 12.3-9z"/></svg>
              <strong>Google</strong>
            </a>
            <a class="review-badge facebook" href={facebook} rel="noopener">
              <span>Review us on</span>
              <svg aria-hidden="true" viewBox="0 0 48 48"><circle cx="24" cy="24" r="22" fill="#1877F2"/><path fill="#fff" d="M26.6 46V30.4h5.2l.8-6h-6v-3.9c0-1.7.5-2.9 3-2.9h3.2v-5.4c-.6-.1-2.4-.2-4.6-.2-4.6 0-7.7 2.8-7.7 7.9v4.5h-5.2v6h5.2V46z"/></svg>
              <strong>Facebook</strong>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container foot-grid">
        <div>
          <Image class="foot-logo" src={logoWhite} alt="JSW Foam Insulation Inc." width={170} densities={[1, 2]} />
          <p class="muted">Spray foam insulation, cellulose and pole buildings for Northern Michigan homes, farms and businesses. Licensed and insured.</p>
          <h3 class="foot-heading">Follow Us</h3>
          <a class="foot-social" href={facebook} rel="noopener">Facebook</a>
        </div>
        <div>
          <h3 class="foot-heading">Quick Links</h3>
          <ul class="foot-links">
            {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            <li><a href="#projects">Recent Projects</a></li>
          </ul>
          <a class="btn btn-accent foot-call" href={`tel:${phone.tel}`}>Call {phone.display}</a>
        </div>
        <div>
          <h3 class="foot-heading">Company Info</h3>
          <address>
            {name}<br />
            LeRoy, MI 49655<br />
            <a href={`tel:${phone.tel}`}>{phone.display}</a><br />
            <a href={`mailto:${email}`}>{email}</a>
          </address>
          <h3 class="foot-heading">Hours</h3>
          <p class="muted">Call or text any time to set up an estimate.</p>
        </div>
      </div>
      <div class="copyright">
        <div class="container">© 2026 {name} · Concept mockup by Schrader Web Solutions, not the live site.</div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.querySelector(".menu-btn"), nav = document.getElementById("site-nav");
        const set = (open) => { btn.setAttribute("aria-expanded", open); btn.setAttribute("aria-label", open ? "Close menu" : "Open menu"); nav.classList.toggle("open", open); };
        btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
        nav.addEventListener("click", (e) => { if (e.target.closest("a")) set(false); });

        const track = document.querySelector(".carousel-track");
        document.querySelectorAll(".carousel-arrow").forEach((b) =>
          b.addEventListener("click", () => track.scrollBy({ left: b.dataset.dir * track.clientWidth * 0.8, behavior: "smooth" })));

        // map loads only on request: keeps Google's iframe and cookies out of the first load
        const map = document.querySelector(".map-facade");
        map.querySelector("button").addEventListener("click", () => {
          map.innerHTML = `<iframe src="${map.dataset.src}" title="Map of LeRoy, Michigan and the surrounding area" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>`;
        });
      })();
    </script>

    <style is:global>
      :root {
        --dark: #16191d; --dark-2: #23282e; --dark-3: #0e1013;
        --accent: #c2410c; --accent-dark: #9a3412; --accent-bright: #fb923c;
        --ink: #16191d; --muted: #4b5563; --bg-soft: #f4f2ef; --white: #fff;
        --font: var(--font-open-sans), Arial, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
      body { margin: 0; font: 400 16px/1.7 var(--font); color: var(--ink); background: var(--white); }
      img { display: block; max-width: 100%; height: auto; }
      h1, h2, h3, p, ul, figure { margin: 0; }
      ul { padding: 0; list-style: none; }
      a { color: inherit; }
      [id] { scroll-margin-top: 72px; }
      :focus-visible { outline: 3px solid var(--accent-bright); outline-offset: 2px; }
      .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .skip { position: absolute; left: 8px; top: -60px; z-index: 100; background: var(--white); padding: 10px 14px; border-radius: 6px; }
      .skip:focus { top: 8px; }
      .small { font-size: 14px; }
      .accent-link { color: var(--accent); font-weight: 700; text-decoration: none; white-space: nowrap; }
      .accent-link:hover { text-decoration: underline; }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 24px; border-radius: 6px; border: 2px solid transparent; font: 700 15px/1.2 var(--font); letter-spacing: .04em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: background-color .2s, color .2s; }
      .btn-accent { background: var(--accent); color: var(--white); }
      .btn-accent:hover { background: var(--accent-dark); }
      .btn-outline { border-color: var(--accent); color: var(--accent); background: transparent; }
      .btn-outline:hover { background: var(--accent); color: var(--white); }
      .btn-block { width: 100%; }
      .pill { display: inline-block; background: var(--accent); color: var(--white); padding: 0 14px; border-radius: 8px; white-space: nowrap; }

      /* header: sits over the hero photo */
      .site-header { position: absolute; top: 0; left: 0; right: 0; z-index: 20; }
      .nav-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 16px; background: rgba(14, 16, 19, .55); }
      .nav-call { display: inline-flex; align-items: center; gap: 8px; color: var(--white); font-weight: 700; text-decoration: none; padding: 8px 4px; }
      .nav-call svg { width: 16px; height: 16px; fill: currentColor; }
      .menu-btn { width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; background: none; border: 0; cursor: pointer; }
      .menu-btn span { display: block; width: 24px; height: 2px; background: var(--white); transition: transform .2s, opacity .2s; }
      .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
      .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
      .site-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--dark); padding: 8px 16px 16px; }
      .site-nav.open { display: block; }
      .site-nav a { display: block; padding: 12px 4px; color: var(--white); text-decoration: none; font-weight: 600; border-bottom: 1px solid rgba(255, 255, 255, .1); }

      /* hero */
      .hero { position: relative; isolation: isolate; color: var(--white); padding: 96px 0 56px; background: var(--dark); }
      .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 75%; z-index: -2; }
      .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to right, rgba(10, 12, 15, .82) 0%, rgba(10, 12, 15, .6) 55%, rgba(10, 12, 15, .35) 100%); }
      .hero-grid { display: grid; gap: 32px; align-items: start; }
      .logo-badge { display: grid; place-items: center; width: 132px; height: 132px; border-radius: 50%; background: rgba(255, 255, 255, .95); border: 3px solid rgba(255, 255, 255, .4); box-shadow: 0 8px 24px rgba(0, 0, 0, .4); margin: 0 auto 24px; }
      .logo-badge img { width: 104px; }
      .hero h1 { font-size: clamp(2rem, 6vw, 3.4rem); font-weight: 800; line-height: 1.15; letter-spacing: -.01em; margin-bottom: 20px; text-shadow: 0 2px 12px rgba(0, 0, 0, .5); }
      .hero h1 span { color: var(--accent-bright); }
      .hero-sub { font-size: clamp(1rem, 1.8vw, 1.15rem); line-height: 1.75; max-width: 540px; border-left: 4px solid var(--accent-bright); padding-left: 16px; text-shadow: 0 1px 8px rgba(0, 0, 0, .8); }

      .estimate-card { background: rgba(22, 25, 29, .94); border-radius: 12px; padding: 24px; box-shadow: 0 10px 30px rgba(0, 0, 0, .35); display: grid; gap: 10px; }
      .estimate-title { text-align: center; font-size: 1.25rem; font-weight: 600; line-height: 1.5; display: grid; justify-items: center; gap: 8px; margin-bottom: 6px; }
      .estimate-title .pill { padding: 8px 20px; border-radius: 999px; font-size: 1.15rem; font-weight: 800; box-shadow: 0 4px 0 rgba(0, 0, 0, .15); }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .estimate-card input, .estimate-card select, .estimate-card textarea { width: 100%; min-height: 46px; padding: 10px 14px; border: 1px solid #cbd0d6; border-radius: 8px; font: 400 15px/1.4 var(--font); color: var(--ink); background: var(--white); }
      .estimate-card textarea { resize: vertical; }
      .estimate-card ::placeholder { color: #5f6773; }
      .estimate-card .btn { margin-top: 6px; min-height: 52px; }
      .form-note { font-size: 13px; color: #d1d5db; text-align: center; }
      .form-note a { color: var(--white); white-space: nowrap; }

      /* about */
      .about { display: grid; background: var(--bg-soft); }
      .about-img img { width: 100%; height: 100%; min-height: 280px; max-height: 440px; object-fit: cover; }
      .about-copy { padding: 48px 20px; max-width: 760px; }
      .about-copy p { margin-bottom: 14px; color: #2d333b; }
      .section-title { font-size: clamp(1.6rem, 3.6vw, 2.2rem); font-weight: 800; line-height: 1.3; color: var(--ink); margin-bottom: 24px; }
      .section-title .pill { margin-top: 6px; }
      .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36px 16px; margin: 40px 0 36px; text-align: center; }
      .stats li { display: flex; flex-direction: column; align-items: center; max-width: 170px; margin: 0 auto; width: 100%; }
      .stat-value { position: relative; z-index: 1; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: radial-gradient(circle at top, #ea580c, var(--accent-dark)); color: var(--white); font-size: 1.6rem; font-weight: 800; border: 4px solid var(--white); box-shadow: 0 6px 14px rgba(0, 0, 0, .2); }
      .stat-label { width: 100%; margin-top: -42px; padding: 50px 10px 16px; border-radius: 10px; background: linear-gradient(to bottom, var(--dark-2), var(--dark-3)); color: var(--white); font-size: .78rem; font-weight: 700; line-height: 1.3; text-transform: uppercase; letter-spacing: .02em; }
      .about-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; font-size: 1.1rem; }

      /* services */
      .services { background: var(--dark); color: var(--white); padding: 72px 0; text-align: center; }
      .services h2, .projects h2 { font-size: clamp(1.7rem, 3.6vw, 2.2rem); font-weight: 800; line-height: 1.25; margin-bottom: 10px; }
      .section-sub { color: rgba(255, 255, 255, .72); margin: 0 auto 40px; max-width: 640px; }
      .section-sub.dark { color: var(--muted); }
      .service-grid { display: grid; gap: 24px; text-align: left; }
      .service-card { background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .1); border-radius: 12px; overflow: hidden; transition: transform .3s, box-shadow .3s; }
      .service-card:hover { transform: translateY(-6px); box-shadow: 0 12px 30px rgba(0, 0, 0, .35); }
      .service-card img, .service-art { width: 100%; height: 200px; object-fit: cover; }
      .service-art { display: grid; place-items: center; background: linear-gradient(135deg, #3a2a20, #23282e); color: var(--accent-bright); }
      .service-art svg { width: 55%; }
      .service-body { padding: 22px; }
      .service-body h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; }
      .service-body p { color: rgba(255, 255, 255, .78); font-size: .95rem; line-height: 1.6; }

      /* projects */
      .projects { background: var(--bg-soft); padding: 72px 0; text-align: center; }
      .projects h2 { color: var(--ink); }
      .carousel { position: relative; max-width: 1280px; margin: 0 auto; }
      .carousel-track { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px 20px 24px; scroll-padding: 0 20px; scrollbar-width: thin; }
      .project-card { position: relative; flex: 0 0 78%; max-width: 300px; aspect-ratio: 300 / 380; border-radius: 14px; overflow: hidden; scroll-snap-align: start; box-shadow: 0 10px 24px rgba(0, 0, 0, .18); background: var(--dark-2); }
      .project-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
      .project-card:hover img { transform: scale(1.06); }
      .card-content { position: absolute; left: 0; right: 0; bottom: 0; padding: 48px 20px 20px; background: linear-gradient(transparent, rgba(0, 0, 0, .9)); color: var(--white); text-align: left; }
      .tag { display: inline-block; padding: 3px 12px; border-radius: 999px; color: #111; font-size: .7rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; }
      .card-content h3 { font-size: 1.15rem; font-weight: 700; line-height: 1.3; }
      .card-content p { font-size: .85rem; line-height: 1.5; color: #e5e7eb; margin-top: 4px; }
      .carousel-arrow { display: none; }

      /* credentials */
      .trust-band { background: var(--accent); color: var(--white); padding: 28px 0; }
      .trust-band ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; text-align: center; font-size: .95rem; }
      .trust-band strong { display: block; font-size: 1.25rem; font-weight: 800; }

      /* service area */
      .area { padding: 72px 0; }
      .area-grid { display: grid; gap: 32px; align-items: center; }
      .area p { color: #2d333b; }
      .towns { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0; }
      .towns li { padding: 8px 16px; border-radius: 999px; background: var(--bg-soft); border: 1px solid #e2ddd6; font-weight: 600; font-size: .95rem; }
      .map-facade { min-height: 320px; border-radius: 12px; overflow: hidden; display: grid; place-content: center; justify-items: center; gap: 12px; background: linear-gradient(135deg, #e8e4dd, #d9e2e8); text-align: center; padding: 24px; }
      .map-facade a { font-size: .95rem; }
      .map-facade iframe { position: relative; width: 100%; height: 360px; border: 0; }
      .map-facade:has(iframe) { display: block; padding: 0; }

      /* leave a review */
      .review-cta { padding: 64px 0; text-align: center; background: var(--bg-soft); }
      .review-kicker { font-size: 1.25rem; font-weight: 700; }
      .review-cta h2 { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 800; margin-bottom: 36px; }
      .review-cta .g { color: #1a5fd0; }
      .review-cta .f { color: #1465d8; }
      .review-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; }
      .review-badge { width: 170px; height: 170px; border-radius: 50%; display: grid; place-content: center; justify-items: center; gap: 6px; background: var(--white); text-decoration: none; color: var(--ink); font-size: .9rem; transition: transform .25s; }
      .review-badge:hover { transform: scale(1.06); }
      .review-badge svg { width: 44px; height: 44px; }
      .review-badge strong { font-size: 1.05rem; }
      .review-badge.google { border: 6px solid #4285f4; box-shadow: 0 0 0 6px #fbbc05, 0 10px 24px rgba(0, 0, 0, .12); }
      .review-badge.facebook { border: 6px solid #1877f2; box-shadow: 0 0 0 6px #c7d9f7, 0 10px 24px rgba(0, 0, 0, .12); }

      /* footer */
      .site-footer { background: var(--dark); color: var(--white); padding-top: 56px; }
      .foot-grid { display: grid; gap: 40px; padding-bottom: 40px; }
      .foot-logo { width: 170px; margin-bottom: 20px; }
      .site-footer .muted { color: #c3c8cf; font-size: .95rem; }
      .foot-heading { position: relative; font-size: 1.1rem; font-weight: 700; padding-bottom: 12px; margin: 28px 0 16px; }
      .foot-grid > div > .foot-heading:first-child { margin-top: 0; }
      .foot-heading::after { content: ""; position: absolute; left: 0; bottom: 0; width: 36px; height: 3px; background: var(--accent-bright); }
      .foot-social { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 6px; background: #1462c7; color: var(--white); font-weight: 700; text-decoration: none; }
      .foot-links li a { display: block; padding: 8px 0; color: #d1d5db; text-decoration: none; }
      .foot-links li a:hover { color: var(--white); }
      .foot-call { margin-top: 20px; }
      .site-footer address { font-style: normal; color: #c3c8cf; line-height: 1.9; }
      .site-footer address a { color: var(--white); }
      .copyright { background: var(--dark-3); padding: 16px 0; font-size: .85rem; color: #aab0b8; }

      @media (min-width: 640px) {
        .service-grid { grid-template-columns: repeat(2, 1fr); }
        .stats { grid-template-columns: repeat(4, 1fr); }
        .trust-band ul { grid-template-columns: repeat(4, 1fr); }
        .project-card { flex-basis: 300px; }
      }
      @media (min-width: 900px) {
        .menu-btn { display: none; }
        .nav-bar { padding: 0 32px; flex-direction: row-reverse; }
        .site-nav { display: block; position: static; background: none; padding: 0; }
        .site-nav ul { display: flex; gap: 4px; }
        .site-nav a { border: 0; padding: 20px 14px; font-size: .95rem; }
        .site-nav a:hover { color: var(--accent-bright); }
        .nav-call { background: var(--accent); border-radius: 6px; padding: 10px 18px; }
        .nav-call:hover { background: var(--accent-dark); }
        .hero { padding: 120px 0 72px; min-height: 720px; }
        .hero-grid { grid-template-columns: 1fr 420px; gap: 56px; }
        .logo-badge { margin: 0 0 28px; width: 150px; height: 150px; }
        .logo-badge img { width: 118px; }
        .about { grid-template-columns: 5fr 7fr; }
        .about-img img { max-height: none; }
        .about-copy { padding: 72px 56px; }
        .service-grid { grid-template-columns: repeat(3, 1fr); }
        .area-grid { grid-template-columns: 1fr 1fr; gap: 56px; }
        .map-facade { min-height: 360px; }
        .foot-grid { grid-template-columns: 1.1fr 1fr 1fr; gap: 56px; }
        .carousel-arrow { display: grid; place-items: center; position: absolute; top: 45%; z-index: 2; width: 48px; height: 48px; border-radius: 50%; border: 0; background: rgba(0, 0, 0, .7); color: var(--white); font-size: 28px; line-height: 1; cursor: pointer; }
        .carousel-arrow:hover { background: var(--accent); }
        .carousel-arrow.prev { left: 8px; }
        .carousel-arrow.next { right: 8px; }
        .carousel-track { padding: 8px 72px 24px; scroll-padding: 0 72px; }
      }
    </style>
  </body>
</html>
